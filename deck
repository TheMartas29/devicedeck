class SimDevice(Device):
    kind = "simulator"
    BUTTONS = ("home", "lock", "side", "siri", "apple-pay")

    def rocketsim(self) -> str:
        exe = which("ROCKETSIM", "rocketsim", "/Applications/RocketSim.app/Contents/Resources/CLI/rocketsim",
                    str(Path.home() / "Applications/RocketSim.app/Contents/Resources/CLI/rocketsim"))
        if not exe:
            raise DeckError("simulator elements and input need the RocketSim CLI: install RocketSim "
                            "(https://www.rocketsim.app), then RocketSim > Settings > CLI & Agent > "
                            "Install Command Line Tool")
        return exe

    def rs(self, args: list[str], timeout: float = 60, input: str | None = None) -> dict:
        proc = run([self.rocketsim(), *args, "--udid", self.id], check=False, timeout=timeout, input=input)
        try:
            env = json.loads(proc.stdout)
        except json.JSONDecodeError:
            raise DeckError(f"rocketsim: {(proc.stderr or proc.stdout).strip()[-500:]}") from None
        if not env.get("ok"):
            err = env.get("error") or {}
            hint = f" ({err['recovery_suggestion']})" if err.get("recovery_suggestion") else ""
            raise DeckError(f"rocketsim: {err.get('code')}: {err.get('message')}{hint}")
        return env.get("data") or {}

    def shot(self, path: Path) -> str:
        run(["xcrun", "simctl", "io", self.id, "screenshot", "--type=png", str(path)])
        return "points = pixels / scale (deck info)"

    def elements(self) -> list[str]:
        lines: list[str] = []
        for e in self.rs(["elements"]).get("elements", []):
            (x, y), (w, h) = e.get("frame") or [[0, 0], [0, 0]]
            lines.append(element_line(e.get("role", "?"), e.get("label"), e.get("value"),
                                      e.get("identifier"), x, y, w, h, 1 if e.get("parentId") else 0))
        lines.append("# simulator via RocketSim; coordinates in points")
        return lines

    def tap(self, x: float, y: float) -> str:
        self.rs(["interact", "tap", fmt(x), fmt(y)])
        return "points"

    def swipe(self, x1: float, y1: float, x2: float, y2: float, ms: int) -> str:
        self.rs(["interact", "swipe", "--from", f"{fmt(x1)},{fmt(y1)}", "--to", f"{fmt(x2)},{fmt(y2)}",
                 "--duration", f"{max(ms, 50) / 1000:.2f}"])
        return "points"

    def type_text(self, text: str) -> str:
        ascii_only(text)
        self.rs(["interact", "type", "--stdin"], timeout=120, input=text)
        return f"typed {len(text)} characters"

    def key(self, name: str) -> str:
        if name in self.BUTTONS:
            self.rs(["interact", "button", name])
        elif name == "enter":
            self.rs(["interact", "type", "--stdin"], input="\n")
        else:
            raise DeckError(f"unknown key {name!r} for simulator; supported: {' '.join(self.BUTTONS)} enter",
                            EXIT_USAGE)
        return f"pressed {name}"

    def launch(self, target: str) -> str:
        run(["xcrun", "simctl", "launch", "--terminate-running-process", self.id, target])
        return f"launched {target}"

    def apps(self, all_apps: bool) -> list[str]:
        raw = run(["xcrun", "simctl", "listapps", self.id]).stdout
        data = json.loads(run(["plutil", "-convert", "json", "-o", "-", "-"], input=raw).stdout)
        rows = []
        for bundle, a in data.items():
            if all_apps or a.get("ApplicationType") == "User":
                rows.append(f"{bundle}  {a.get('CFBundleDisplayName') or a.get('CFBundleName') or ''}  "
                            f"{a.get('CFBundleShortVersionString') or ''}".rstrip())
        return sorted(rows)

    def info(self) -> list[tuple[str, str]]:
        lines = ios_info_lines(self, ios_display(self.id))
        try:
            lines.append(("control", self.rocketsim()))
        except DeckError as e:
            lines.append(("control", str(e)))
        return lines


def element_line(role, label, value, ident, x, y, w, h, depth=0) -> str:
    parts = ["  " * min(depth, 6) + str(role or "?")]
    if label:
        parts.append(json.dumps(str(label), ensure_ascii=False))
    if value not in (None, "") and value != label:
        parts.append("=" + json.dumps(str(value), ensure_ascii=False))
    if ident:
        parts.append("#" + str(ident))
    parts.append(f"@{fmt(x + w / 2)},{fmt(y + h / 2)} [{fmt(x)},{fmt(y)} {fmt(w)}x{fmt(h)}]")
    return " ".join(parts)


def detect_sims() -> list[Device]:
    if not shutil.which("xcrun"):
        return []
    try:
        data = json.loads(run(["xcrun", "simctl", "list", "devices", "booted", "-j"], timeout=30).stdout)
    except (DeckError, json.JSONDecodeError):
        return []
    devices: list[Device] = []
    for runtime, sims in data.get("devices", {}).items():
        m = re.search(r"SimRuntime\.(\w+)-([\d-]+)", runtime)
        os_name = f"{m.group(1)} {m.group(2).split('-')[0]}.{'.'.join(m.group(2).split('-')[1:])}".rstrip(".") if m else runtime
        for s in sims:
            model = s.get("deviceTypeIdentifier", "").rsplit(".", 1)[-1].replace("-", " ")
            devices.append(SimDevice(s["udid"], s.get("name", ""), model, os_name, s.get("state", "").lower()))
    return devices


# ---------------------------------------------------------------- Android


class AndroidDevice(Device):
    kind = "android"
    KEYS = {"home": "KEYCODE_HOME", "back": "KEYCODE_BACK", "enter": "KEYCODE_ENTER", "backspace": "KEYCODE_DEL",
            "tab": "KEYCODE_TAB", "escape": "KEYCODE_ESCAPE", "up": "KEYCODE_DPAD_UP", "down": "KEYCODE_DPAD_DOWN",
            "left": "KEYCODE_DPAD_LEFT", "right": "KEYCODE_DPAD_RIGHT", "menu": "KEYCODE_MENU",
            "power": "KEYCODE_POWER", "volume-up": "KEYCODE_VOLUME_UP", "volume-down": "KEYCODE_VOLUME_DOWN",
            "app-switch": "KEYCODE_APP_SWITCH", "search": "KEYCODE_SEARCH"}

    def adb(self, args: list[str], **kw) -> subprocess.CompletedProcess:
        return run([adb_path(), "-s", self.id, *args], **kw)

    def sh(self, cmd: str, **kw) -> str:
        return self.adb(["shell", cmd], **kw).stdout

    def shot(self, path: Path) -> str:
        data = self.adb(["exec-out", "screencap", "-p"], text=False).stdout
        if not data.startswith(b"\x89PNG"):
            raise DeckError("screencap did not return a PNG")
        path.write_bytes(data)
        return "tap units are these pixels"

    def elements(self) -> list[str]:
        remote = "/data/local/tmp/deck-ui.xml"
        self.sh(f"uiautomator dump {remote} >/dev/null", timeout=60)
        xml = self.adb(["exec-out", "cat", remote]).stdout
        self.sh(f"rm -f {remote}", check=False)
        lines: list[str] = []
        walk_android(ET.fromstring(xml), 0, lines)
        lines.append("# android via uiautomator; coordinates in pixels")
        return lines

    def tap(self, x: float, y: float) -> str:
        self.sh(f"input tap {fmt(x)} {fmt(y)}")
        return "pixels"

    def swipe(self, x1: float, y1: float, x2: float, y2: float, ms: int) -> str:
        self.sh(f"input swipe {fmt(x1)} {fmt(y1)} {fmt(x2)} {fmt(y2)} {ms}")
        return "pixels"

    def type_text(self, text: str) -> str:
        ascii_only(text)
        for i, chunk in enumerate(text.split("\n")):
            if i:
                self.sh("input keyevent KEYCODE_ENTER")
            if chunk:
                self.sh("input text " + shlex.quote(chunk.replace(" ", "%s")))
        return f"typed {len(text)} characters"

    def key(self, name: str) -> str:
        code = self.KEYS.get(name) or (name if re.fullmatch(r"KEYCODE_[A-Z0-9_]+|\d+", name) else None)
        if not code:
            raise DeckError(f"unknown key {name!r} for android; supported: {' '.join(self.KEYS)}, "
                            "KEYCODE_* or a number", EXIT_USAGE)
        self.sh(f"input keyevent {code}")
        return f"pressed {name}"

    def launch(self, target: str) -> str:
        if not re.fullmatch(r"[\w.]+(/[\w.$]+)?", target):
            raise DeckError(f"not a package or package/activity: {target!r}", EXIT_USAGE)
        if "/" in target:
            out = self.sh(f"am start -n {target}")
        else:
            out = self.sh(f"monkey -p {target} -c android.intent.category.LAUNCHER 1")
        if "Error" in out or "No activities found" in out or "aborted" in out:
            raise DeckError(out.strip())
        return f"launched {target}"

    def apps(self, all_apps: bool) -> list[str]:
        out = self.sh("pm list packages" + ("" if all_apps else " -3"))
        return sorted(line.split(":", 1)[1] for line in out.splitlines() if line.startswith("package:"))

    def info(self) -> list[tuple[str, str]]:
        size = re.findall(r"(\d+)x(\d+)", self.sh("wm size"))
        dens = re.findall(r"(\d+)", self.sh("wm density"))
        lines = [("id", self.id), ("kind", self.kind), ("name", self.name), ("model", self.model),
                 ("os", self.os), ("state", self.state), ("physical", "yes" if self.physical else "no (emulator)")]
        if size:
            w, h = size[-1]
            lines.append(("screen", f"{w}x{h} px"))
        if dens:
            d = int(dens[-1])
            lines += [("density", f"{d} dpi"), ("scale", fmt(d / 160) if d % 160 else str(d // 160)),
                      ("points", f"{fmt(int(size[-1][0]) * 160 / d)}x{fmt(int(size[-1][1]) * 160 / d)} dp" if size else "?")]
        lines.append(("tap units", "pixels"))
        lines.append(("input", "allowed" if self.input_allowed else "locked (see deck --help)"))
        return lines


def walk_android(node: ET.Element, depth: int, lines: list[str]) -> None:
    for child in node:
        a = child.attrib
        text, desc, rid = a.get("text", ""), a.get("content-desc", ""), a.get("resource-id", "")
        clickable = a.get("clickable") == "true"
        if text or desc or rid or clickable:
            m = [int(v) for v in re.findall(r"-?\d+", a.get("bounds", ""))]
            if len(m) == 4:
                x1, y1, x2, y2 = m
                role = a.get("class", "?").rsplit(".", 1)[-1] + (" (clickable)" if clickable else "")
                lines.append(element_line(role, text or desc, desc if text and desc else None,
                                          rid.split(":id/")[-1] if rid else None,
                                          x1, y1, x2 - x1, y2 - y1, depth))
        walk_android(child, depth + 1, lines)


def adb_path() -> str:
    exe = which("ADB", "adb")
    if not exe:
        sdk = os.environ.get("ANDROID_HOME") or os.environ.get("ANDROID_SDK_ROOT") or str(Path.home() / "Library/Android/sdk")
        cand = Path(sdk) / "platform-tools/adb"
        if cand.exists():
            return str(cand)
        raise DeckError("adb not found (install Android platform-tools)")
    return exe


def detect_android() -> list[Device]:
    try:
        exe = adb_path()
        out = run([exe, "devices", "-l"], timeout=20).stdout
    except DeckError:
        return []
    devices: list[Device] = []
    for line in out.splitlines()[1:]:
        parts = line.split()
        if len(parts) < 2:
            continue
        serial, state = parts[0], parts[1]
        model = next((p.split(":", 1)[1] for p in parts if p.startswith("model:")), "")
        dev = AndroidDevice(serial, "", model, "Android", state)
        dev.physical = not serial.startswith("emulator-")
        if state == "device":
            props = run([exe, "-s", serial, "shell",
                         "getprop ro.product.model; getprop ro.build.version.release; getprop ro.boot.qemu.avd_name; "
                         "getprop ro.kernel.qemu; getprop ro.boot.qemu; settings get global device_name"],
                        check=False, timeout=15).stdout.splitlines() + [""] * 6
            pmodel, release, avd, kq, bq, dname = (p.strip() for p in props[:6])
            dev.model = pmodel or model
            dev.os = f"Android {release}" if release else "Android"
            dev.physical = not (serial.startswith("emulator-") or kq == "1" or bq == "1")
            dev.name = avd or (dname if dname and dname != "null" else "") or dev.model
        else:
            dev.name = model or serial
        devices.append(dev)
    return devices


# ---------------------------------------------------------------- discovery + selection

KIND_RANK = {"ios": 0, "simulator": 1, "android": 2}


def discover() -> list[Device]:
    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:
        futures = [pool.submit(f) for f in (detect_ios, detect_sims, detect_android)]
        devices = [d for f in futures for d in f.result()]
    config = load_config()
    for d in devices:
        c = config.get(d.id)
        if c and c.get("kind") in (None, d.kind):
            if c.get("name"):
                d.name = str(c["name"])
            d.hidden = bool(c.get("hidden", False))
            d.order = int(c.get("order") or 0)
            d.allow_input = c.get("allowInput") is not False
            d.config = c
    devices.sort(key=lambda d: (d.order, KIND_RANK.get(d.kind, 9), not d.usable, d.name.lower()))
    return devices


def select(devices: list[Device], selector: str | None) -> Device:
    if selector is None:
        pool = [d for d in devices if d.usable]
        if len(pool) == 1:
            return pool[0]
        if not pool:
            raise DeckError("no connected device; run: deck list", EXIT_USAGE)
        raise DeckError("several devices are connected; name one:\n" + table(pool), EXIT_USAGE)
    for d in devices:
        if d.id.lower() == selector.lower():
            return d
    s = selector.lower()
    exact = [d for d in devices if d.name.lower() == s]
    if len(exact) == 1:
        return exact[0]
    matches = exact or [d for d in devices if s in d.name.lower()]
    if len(matches) == 1:
        return matches[0]
    if not matches:
        raise DeckError(f"no device matches {selector!r}; run: deck list", EXIT_USAGE)
    raise DeckError(f"{selector!r} is ambiguous:\n" + table(matches), EXIT_USAGE)


def table(devices: list[Device]) -> str:
    rows = [("ID", "KIND", "NAME", "MODEL", "OS", "STATE", "INPUT")]
    for d in devices:
        rows.append((d.id, d.kind, d.name + (" (hidden)" if d.hidden else ""), d.model, d.os, d.state,
                     "yes" if d.input_allowed else "locked"))
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    return "\n".join("  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip() for r in rows)


# ---------------------------------------------------------------- main


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0 if argv else EXIT_USAGE
    if argv[0] == "list":
        flags = set(argv[1:])
        if flags - {"--all", "--json"}:
            raise DeckError(f"unknown option for list: {' '.join(sorted(flags - {'--all', '--json'}))}", EXIT_USAGE)
        devices = discover()
        if "--json" in flags:
            print(json.dumps([d.as_dict() for d in devices], indent=2, ensure_ascii=False))
        elif devices:
            print(table(devices))
        else:
            print("no devices found (checked devicectl, simctl booted, adb)")
        return 0

    if argv[0] in COMMANDS:
        selector, cmd, args = None, argv[0], argv[1:]
    elif len(argv) >= 2 and argv[1] in COMMANDS:
        selector, cmd, args = argv[0], argv[1], argv[2:]
    else:
        raise DeckError(f"unknown command: {' '.join(argv[:2])}\n\n{USAGE}", EXIT_USAGE)

    def need(n: int, upto: int | None = None, usage: str = "") -> None:
        if not (n <= len(args) <= (upto if upto is not None else n)):
            raise DeckError(f"usage: deck [<dev>] {cmd} {usage}".rstrip(), EXIT_USAGE)

    # Validate arguments before touching any device.
    if cmd == "shot":
        need(1, usage="<file.png>")
    elif cmd == "tap":
        need(2, usage="<x> <y>")
        x, y = (num(a, "coordinate") for a in args)
    elif cmd == "swipe":
        need(4, 5, "<x1> <y1> <x2> <y2> [ms]")
        coords = [num(a, "coordinate") for a in args[:4]]
        ms = int(num(args[4], "ms")) if len(args) == 5 else 300
        if ms < 0:
            raise DeckError("ms must be >= 0", EXIT_USAGE)
    elif cmd == "type":
        if not args:
            raise DeckError("usage: deck [<dev>] type <text>", EXIT_USAGE)
        text = " ".join(args)
    elif cmd in ("key", "launch"):
        need(1, usage="<name>" if cmd == "key" else "<bundle id | package>")
    elif cmd == "apps":
        need(0, 1, "[--all]")
        if args and args[0] != "--all":
            raise DeckError("usage: deck [<dev>] apps [--all]", EXIT_USAGE)
    else:
        need(0)

    dev = select(discover(), selector)
    if not dev.usable and cmd != "wda-stop":
        raise DeckError(f"{dev.name} ({dev.id}) is {dev.state}, not connected")
    if cmd in GUARDED_COMMANDS and not dev.input_allowed:
        why = ("its config entry has \"allowInput\": false" if not dev.allow_input
               else "DEVICEDECK_LOCK_PHYSICAL_INPUT=1 locks physical devices")
        raise DeckError(f"refused: input to {dev.name} ({dev.id}) is locked because {why}. "
                        f"Only the device owner can unlock it.", EXIT_GUARD)

    if cmd == "shot":
        path = Path(args[0]).expanduser().resolve()
        path.parent.mkdir(parents=True, exist_ok=True)
        note = dev.shot(path)
        size = png_size(path)
        print(f"{path}  {size[0]}x{size[1]} px  ({note})" if size else str(path))
    elif cmd == "elements":
        print("\n".join(dev.elements()))
    elif cmd == "tap":
        unit = dev.tap(x, y)
        print(f"tapped {fmt(x)},{fmt(y)} ({unit}) on {dev.name}")
    elif cmd == "swipe":
        unit = dev.swipe(*coords, ms)
        print(f"swiped {fmt(coords[0])},{fmt(coords[1])} -> {fmt(coords[2])},{fmt(coords[3])} in {ms} ms ({unit}) on {dev.name}")
    elif cmd == "type":
        print(dev.type_text(text))
    elif cmd == "key":
        print(dev.key(args[0].lower() if not args[0].startswith("KEYCODE_") else args[0]))
    elif cmd == "launch":
        print(dev.launch(args[0]))
    elif cmd == "apps":
        rows = dev.apps(bool(args))
        print("\n".join(rows) if rows else "no apps")
    elif cmd in ("wda-setup", "wda-stop"):
        if not isinstance(dev, IOSDevice):
            raise DeckError(f"{cmd} is only for physical iPhones, not {dev.kind} devices", EXIT_USAGE)
        print(dev.wda_setup() if cmd == "wda-setup" else dev.wda_stop())
    elif cmd == "info":
        lines = dev.info()
        width = max(len(k) for k, _ in lines)
        print("\n".join(f"{k.ljust(width)}  {v}" for k, v in lines))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except DeckError as e:
        print(f"deck: {e}", file=sys.stderr)
        sys.exit(e.code)
    except KeyboardInterrupt:
        sys.exit(130)
